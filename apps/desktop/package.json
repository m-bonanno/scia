{
  "name": "@scia/desktop",
  "productName": "Scia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scia desktop shell — Electron main/preload supervising the local download engine",
  "author": "Scia",
  "homepage": "https://github.com/m-bonanno/scia",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node scripts/fetch-tools.ts && electron . --user-data-dir=.dev-profile --port=47822",
    "dist": "electron-builder --config electron-builder.yml --publish never",
    "dist:dir": "electron-builder --config electron-builder.yml --dir --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/icons/draw-icons.ts"
  },
  "devDependencies": {
    "@scia/contracts": "*",
    "@scia/core": "*",
    "@scia/server": "*",
    "builder-util-runtime": "9.7.0",
    "electron": "44.10.1",
    "electron-builder": "^26.18.0",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.11",
    "zod": "^4.6.7"
  }
}
