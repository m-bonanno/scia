# Normalise line endings: LF in the repo, whatever the OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.gif binary
*.bmp binary
*.jpg binary
*.ico binary
*.icns binary
*.woff2 binary
*.node binary

# Signed bytes: a release of yt-dlp as its project published it (apps/server/src/testing).
SHA2-256SUMS* binary
