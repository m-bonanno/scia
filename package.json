{
  "name": "scia",
  "private": true,
  "type": "module",
  "description": "Scia monorepo — a fast, minimal download manager for Windows and Linux",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/contracts",
    "apps/server",
    "apps/renderer",
    "apps/desktop",
    "apps/extension"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && npm run start -w @scia/desktop",
    "build": "npm run build --workspaces --if-present",
    "dist": "npm run build && npm run dist -w @scia/desktop",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit --project unit-renderer --project integration --project feature",
    "test:unit": "vitest run --project unit --project unit-renderer",
    "test:integration": "vitest run --project integration",
    "test:feature": "vitest run --project feature",
    "release": "semantic-release"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "electron": true,
    "electron-winstaller": false
  }
}
